let hz=23 hy=-3.6
hips: blob 0,3.2,5.6 r=4.6,5,5 blend=2
torso: limb 0,2.4,7 0,-0.6,12.5 0,-1.8,16.5 r=4.6,3.8,3.1 blend=2.5
chest: blob 0,-3,13.2 r=3.3,2.6,4.6 blend=2
haunch_l: blob 3.6,3.6,4.6 r=2.6,4.6,4.2 rx=-20 blend=1.6
mirror x of=haunch_l
neck: limb 0,-1.8,16.5 0,hy+0.4,hz-2.6 r=2.8,2.4 blend=1.6
head: blob 0,hy,hz r=3.3,3,2.8 blend=1.4
cheek_l: blob 2.2,hy+0.2,hz-1.5 r=1.3,1.9,1.2 rz=-35 ry=-25 blend=1.6
mirror x of=cheek_l
muzzle: limb 0,hy-2,hz-0.6 0,hy-6,hz-1.2 r=1.5,0.55 blend=1.2
jaw: limb 0,hy-1.6,hz-1.9 0,hy-5.2,hz-1.8 r=1.1,0.4 blend=0.8
ear_l: limb 1.9,hy+0.4,hz+1.9 2.9,hy+0.7,hz+4.6 3.5,hy+0.8,hz+6.4 r=1.6,0.95,0.12 blend=0.9
mirror x of=ear_l
leg_l: limb 1.7,-2.6,11 1.7,-3.4,5.5 1.7,-3.7,1.2 r=1.25,0.85,0.75 blend=1.2
mirror x of=leg_l
paw_l: blob 1.7,-4.3,0.7 r=0.95,1.25,0.7 blend=0.6
mirror x of=paw_l
foot_l: limb 4.4,2,1.4 4.6,-2,0.75 r=1.05,0.85 blend=1
mirror x of=foot_l
tail: limb 0,7.6,3 3.6,9.2,2.4 7.2,6.6,2.2 7.8,1.4,2.1 6,-3.2,1.9 r=1.2,2.4,2.9,2.6,1.6 blend=1.4
tip: limb 6,-3.2,1.9 4.6,-5.4,1.8 r=1.6,0.5 blend=1
nose: blob 0,hy-6.25,hz-0.95 r=0.62,0.5,0.45 mode=shell
eye_l: blob 1.6,hy-2.05,hz+0.55 r=0.95,0.42,0.6 rz=-30 ry=-14 mode=shell
pupil_l: blob 1.66,hy-2.4,hz+0.55 r=0.3,0.2,0.5 rz=-30 mode=shell
mirror x of=eye_l
mirror x of=pupil_l
remesh 0.12
relax 4
ears: select ear_l mirror=x falloff=0.6
scale 1,0.42,1
cup: select sphere=2.9,hy-0.2,hz+4 r=0.9 mirror=x falloff=0.7
move 0,0.35,0
paws: select paw_l,paw_r,foot_l,foot_r falloff=0.3
flatten at=0,0,0.15 normal=z cut
hips_floor: select hips,haunch_l,haunch_r,tail,tip falloff=0.4
flatten at=0,0,0.15 normal=z cut
brush clay type=clay size=0.8 strength=0.12 falloff=smooth mirror=x
brush dam type=dam_standard size=0.18 strength=0.08 lazy=0.4 mirror=x
brush soft type=smooth size=1 strength=0.6
stroke dam 0.4,hy-5.8,hz-1.75 1,hy-3.6,hz-1.85 1.4,hy-2.6,hz-1.6
stroke clay 1.3,hy-1.6,hz+1.4 1.7,hy-2.1,hz+1.1 pressure=0.4,1
fur: select tail,tip,chest,cheek_l,cheek_r falloff=0.6
noise 0.12 size=0.7 seed=3
noise 0.05 size=0.25 seed=4
select all
color #c9581c
color #f3ede3 part=chest soft=1.8
color #f3ede3 part=cheek_l soft=0.8
color #f3ede3 part=cheek_r soft=0.8
color #f3ede3 part=jaw soft=0.6
color #f3ede3 part=tip soft=0.8
color #2a1a12 part=leg_l soft=1.5
color #2a1a12 part=leg_r soft=1.5
color #2a1a12 part=paw_l
color #2a1a12 part=paw_r
color #2a1a12 part=foot_l soft=0.6
color #2a1a12 part=foot_r soft=0.6
color #3a2216 part=ear_l soft=1
color #3a2216 part=ear_r soft=1
color #15100c part=nose gloss=0.9
color #d89a2a part=eye_l gloss=0.6
color #d89a2a part=eye_r gloss=0.6
color #120c08 part=pupil_l gloss=0.9
color #120c08 part=pupil_r gloss=0.9
