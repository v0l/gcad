FoamFile { version 2.0; format ascii; class dictionary; object fvSolution; }
solvers
{
    rho { solver PCG; preconditioner DIC; tolerance 1e-7; relTol 0; }
    p_rgh { solver GAMG; tolerance 1e-8; relTol 0.01; smoother GaussSeidel; }
    "(U|h)" { solver PBiCGStab; preconditioner DILU; tolerance 1e-8; relTol 0.1; }
}
SIMPLE { momentumPredictor yes; nNonOrthogonalCorrectors 0; pRefCell 0; pRefValue 100000; rhoMin 0.2; rhoMax 2; }
relaxationFactors { fields { rho 1.0; p_rgh 0.7; } equations { U 0.3; h 0.7; } }
