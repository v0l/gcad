FoamFile { version 2.0; format ascii; class dictionary; object snappyHexMeshDict; }
castellatedMesh true;
snap true;
addLayers LAYERS;
geometry
{
    sphere.stl { type triSurfaceMesh; name ball; }
    near { type searchableSphere; centre (0 0 0); radius 1.0; }
    wake { type searchableBox; min (-0.8 -0.8 -0.8); max (4 0.8 0.8); }
}
castellatedMeshControls
{
    maxLocalCells 4000000; maxGlobalCells 20000000; minRefinementCells 10; nCellsBetweenLevels 3;
    maxLoadUnbalance 0.1;
    features ();
    refinementSurfaces { ball { level (LEVEL LEVEL); patchInfo { type wall; } } }
    resolveFeatureAngle 30;
    refinementRegions
    {
        near { mode inside; levels ((1E15 NEAR)); }
        wake { mode inside; levels ((1E15 WAKE)); }
    }
    locationInMesh (-3.1 0.13 0.17);
    allowFreeStandingZoneFaces true;
}
snapControls { nSmoothPatch 3; tolerance 2.0; nSolveIter 50; nRelaxIter 5; nFeatureSnapIter 10; }
addLayersControls
{
    relativeSizes true;
    layers { ball { nSurfaceLayers 4; } }
