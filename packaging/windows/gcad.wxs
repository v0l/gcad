<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="gcad"
      Manufacturer="v0l"
      Version="$(var.Version)"
      UpgradeCode="c6abda12-74ed-4042-8ae9-05d7b4cfeb16"
      Scope="perMachine"
      Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of gcad is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="packaging\windows\icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/v0l/gcad" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="gcad">
        <Component Id="AppExe" Guid="a5bc21ee-64ec-470a-b6b0-fa639743e4f6">
          <File Id="GcadExe" Source="$(var.BinDir)\gcad.exe" KeyPath="yes" />
          <Environment Id="GcadPath" Name="PATH" Value="[INSTALLFOLDER]" Action="set" Part="last" System="yes" Permanent="no" />
        </Component>
        <Component Id="AppDocs" Guid="38868f7d-fee8-4a3b-aea9-f85ae1b17de5">
          <File Id="ReadmeMd" Source="README.md" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="AppShortcut" Guid="69dc123b-c44c-4c2d-a6e3-0a8e6aeaee4c">
        <Shortcut Id="GcadShortcut" Icon="AppIcon" Name="gcad" Target="[#GcadExe]" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKLM" Key="Software\v0l\Gcad" Name="shortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="Main" Title="gcad" Level="1">
      <ComponentRef Id="AppExe" />
      <ComponentRef Id="AppDocs" />
      <ComponentRef Id="AppShortcut" />
    </Feature>
  </Package>
</Wix>
