let hz=27 hy=-13 tail=1 budget=0
torso: blob 0,0,17 r=5,10,5.6
chest: blob 0,-8,18 r=5.2,5,6.2 blend=2.5
belly: blob 0,2,14.5 r=4,6,3 blend=2
hips: blob 0,8,17.5 r=4.8,4.6,5 blend=2.5
neck: limb 0,-9,21 0,hy+2.5,hz-3 r=3.6,3.1 blend=2
head: blob 0,hy,hz r=4.4,4,3.8 blend=1.5
brow: blob 0,hy-2,hz+1.6 r=3.2,2.4,1.6 blend=1.2
cheek_l: blob 3.6,hy+0.6,hz-2.1 r=1.5,2.2,1.6 rx=-25 blend=1.2
mirror x of=cheek_l
muzzle: limb 0,hy-2.5,hz-0.6 0,hy-8.6,hz-1.6 r=2.1,0.9 blend=1.4
jaw: limb 0,hy-2,hz-2.6 0,hy-7.8,hz-2.4 r=1.7,0.6 blend=1
nose: blob 0,hy-8.75,hz-1.3 r=0.75,0.6,0.55 blend=0.35
eye_l: blob 1.95,hy-3.55,hz+0.9 r=0.85,0.3,0.42 rz=-30 ry=-12 blend=0.2
mirror x of=eye_l
ear_l: limb 2.5,hy+1.1,hz+2.6 3.4,hy+1,hz+5.6 4.1,hy+0.9,hz+8.4 r=2.2,1.3,0.15 blend=1
mirror x of=ear_l
shoulder_l: blob 3.2,-7.5,19 r=2.3,3.2,3.6 blend=1.6
mirror x of=shoulder_l
foreleg_l: limb 3.2,-8,16 3.1,-8.4,9 3.1,-8.2,3.4 3.1,-8.6,1.6 r=2,1.3,1.05,1.05 blend=1.2
mirror x of=foreleg_l
forepaw_l: blob 3.1,-9.4,1 r=1.25,1.6,0.95 blend=0.6
toe_l: blob 2.65,-10.5,0.62 r=0.45,0.7,0.5 blend=0.35
toe2_l: blob 3.45,-10.65,0.62 r=0.45,0.7,0.5 blend=0.35
mirror x of=forepaw_l
mirror x of=toe_l
mirror x of=toe2_l
thigh_l: blob 3.3,7.5,15.5 r=2.5,4,4.6 blend=1.8
mirror x of=thigh_l
hindleg_l: limb 3.3,8.6,12 3.4,6,6.8 3.3,9.4,3.6 3.3,8.6,1.6 r=2.1,1.4,1.05,1.05 blend=1.2
mirror x of=hindleg_l
hindpaw_l: blob 3.3,7.2,1 r=1.25,1.6,0.95 blend=0.6
htoe_l: blob 2.85,6.1,0.62 r=0.45,0.7,0.5 blend=0.35
htoe2_l: blob 3.65,5.95,0.62 r=0.45,0.7,0.5 blend=0.35
mirror x of=hindpaw_l
mirror x of=htoe_l
mirror x of=htoe2_l
tail: limb 0,11.5,18 0,16,18.5 0,21,15 0,24.5,10.5 0,26.5,6.5 r=1.4,3.1,3.6,3,1.1 blend=1.6
tip: blob 0,26.6,6.3 r=1.6,1.7,2 blend=1.1
remesh 0.2

ears: select ear_l mirror=x falloff=1
scale 1,0.45,1
cup: select sphere=3.3,hy+0.3,hz+5.4 r=1.3 mirror=x falloff=0.8
move 0,0.4,0

face: select head,brow,muzzle,jaw,nose,cheek_l,cheek_r,eye_l,eye_r falloff=1.5
refine 0.1
mouth: select jaw falloff=0.3
crease 1.6,hy-3.9,hz-2.3 0.3,hy-8,hz-2.45 depth=0.1 width=0.2
crease -1.6,hy-3.9,hz-2.3 -0.3,hy-8,hz-2.45 depth=0.1 width=0.2
snout: select muzzle,nose falloff=1
scale 1,1,0.85
lips: select sphere=1.7,-18.5,24.6 r=3 mirror=x falloff=0.5
crease 0.8,-20.55,24.57 1.67,-16.75,24.86 depth=0.25 width=0.22
crease 1.67,-16.75,24.86 1.82,-15.6,24.3 depth=0.2 width=0.2
ruff: select cheek_l,cheek_r falloff=0.6
noise 0.1 size=0.6 seed=2
tufts: select sphere=4.5,hy+2,hz-3.2 r=1 mirror=x falloff=1
move 0.6,0.8,-0.6
lids: select sphere=2.55,-16.7,28 r=1.2 mirror=x falloff=0.3
crease 2.2,-17.4,28.3 2.9,-16.1,28.25 depth=-0.12 width=0.18

paws: select forepaw_l,forepaw_r,hindpaw_l,hindpaw_r,foreleg_l,foreleg_r,hindleg_l,hindleg_r falloff=0.3
refine 0.12
flatten at=0,0,0.25 normal=z cut

fur: select tail,tip falloff=1
scale tail
noise 0.18 size=1.1 seed=5
noise 0.06 size=0.3 seed=6
bib: select chest falloff=1
noise 0.07 size=0.4 seed=9

if budget>0 select all
if budget>0 decimate budget
color #c85a1a
color #f4efe6 part=chest
color #f4efe6 part=jaw
color #f4efe6 part=tip
color #f4efe6 part=cheek_l
color #f4efe6 part=cheek_r
color #2b1a12 part=nose
color #1d1410 part=eye_l
color #1d1410 part=eye_r
color #2b1a12 part=forepaw_l
color #2b1a12 part=forepaw_r
color #2b1a12 part=hindpaw_l
color #2b1a12 part=hindpaw_r
color #3a2416 part=ear_l
color #3a2416 part=ear_r
color #2b1a12 part=toe_l
color #2b1a12 part=toe2_l
color #2b1a12 part=toe_r
color #2b1a12 part=toe2_r
color #2b1a12 part=htoe_l
color #2b1a12 part=htoe2_l
color #2b1a12 part=htoe_r
color #2b1a12 part=htoe2_r
