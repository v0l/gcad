let w=80 d=50 h=30 t=2 r=6 boss=7 screw=2.5
rect w d r=r
box: extrude h
shell t open=box.end
plane XY offset=t
let bx=w/2-r-2 by=d/2-r-2
circle boss at=bx,by
circle boss at=-bx,by
circle boss at=-bx,-by
circle boss at=bx,-by
bosses: extrude h-t-0.2
plane bosses.end
pilot: hole screw bx,by -bx,by -bx,-by bx,-by depth=8
plane >Y
cable: hole 8 0,12 depth=4
plane >X
slot 20 3 at=0,22
array count=3 step=0,-5
vents: cut 4
color #3a6ea5
material petg
body lid
plane XY offset=h
rect w d r=r
top: extrude t
rect w-2*t-0.4 d-2*t-0.4 r=r-t
offset -1.5
lip: extrude -3
plane top.end
text GCAD size=8 at=-10.4,-2.8
logo: cut 0.6
screws: hole 3.2 bx,by -bx,by -bx,-by bx,-by
fillet 1 top.end&top.side
color #e8e8e8
material petg
