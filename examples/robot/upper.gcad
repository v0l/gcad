let L=220 r0=55 r1=44 C=27 m=1.25 ring=54 bolts=26
plane XZ offset=22
pen 0,r0
line L,r1
arc L,-r1 via=L+r1,0
line 0,-r0
arc 0,r0 via=-r0,0
close
beam: extrude -44
plane XZ offset=22
circle 8 at=C,0
circle 8 at=-C/2,C*sin(120)
circle 8 at=-C/2,-C*sin(120)
pins: extrude 19
plane beam.end
gear ring m internal at=-L,0
ring: cut 18
plane beam.start
pilot: hole 23 L,0
mounts: hole 3.4 L+bolts/2,bolts/2 L-bolts/2,bolts/2 L-bolts/2,-bolts/2 L+bolts/2,-bolts/2
color #f39c12
material aluminium
