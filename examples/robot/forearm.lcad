let L=180 r0=28 r1=22 C=22.8 bolts=23
plane XZ offset=-36
pen 0,r0
line L,r1
arc L,-r1 via=L+r1,0
line 0,-r0
arc 0,r0 via=-r0,0
close
beam: extrude -24
plane XZ offset=-36
circle 20
axle: extrude 48
plane beam.start
wrist: hole 13 L,0
pilot: hole 23 L-C,0
mounts: hole 2.6 L-C+bolts/2,bolts/2 L-C-bolts/2,bolts/2 L-C-bolts/2,-bolts/2 L-C+bolts/2,-bolts/2
color #f39c12
material aluminium
