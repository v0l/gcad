let s=1 shift=0 g=12 m=1 pr=8.5 grip=65 rack=36
let pitch=grip-s*pr root=pitch-s*1.25*m tip=pitch+s*m p=pi*m
let wide=p/4+1.25*m*tan(20) narrow=p/4-m*tan(20)
let top=p*(floor((g+6)/p-shift)+shift) start=root-2.5-s*2.5
plane XZ offset=-73
rect 5 rack at=root-s*2.5,s*(g+8-rack/2)
bar: extrude -8
poly root,s*(top-wide) tip,s*(top-narrow) tip,s*(top+narrow) root,s*(top+wide)
teeth: extrude -8
repeat teeth count=floor((rack-4)/p) step=0,-s*p
poly start,s*(g+8) 87,s*(g+8) 87,s*(g-2) 117,s*(g-2) 117,s*(g+16) start,s*(g+16)
jaw: extrude -8
plane XZ offset=-69
rect 12 22 at=111,s*(g+5)
pad: extrude -16
color #2d2f33
material steel
