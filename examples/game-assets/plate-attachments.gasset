asset 1
project ../..
source plate ../parts/plate.gcad body=main
tessellate plate tolerance=0.1
refine plate levels=2 triangle_budget=20416
uv plate projection=box tile=25
node plate source=plate
node base
node tip parent=base translation=0,0,1.5
# Ordinary named child nodes are portable attachment transforms, not engine sockets.
node attachment parent=tip translation=10,0,0
node payload parent=attachment translation=0,5,0
clip bend interpolation=linear
key bend tip time=0 rotation=0,0,0,1
key bend tip time=1 rotation=0.7071067811865476,0,0,0.7071067811865476
clip twist interpolation=linear
key twist tip time=0 rotation=0,0,0,1
key twist tip time=1 rotation=0,0.7071067811865476,0,0.7071067811865476
# Bind with --joints base,tip --blend y,-15,15.
skin plate weights=../../target/game-asset-plate-attachments.weights.json
