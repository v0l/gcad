asset 1
project ../..
source plate ../parts/plate.gcad body=main
tessellate plate tolerance=0.1
uv plate projection=box tile=25
node plate source=plate
node base
node tip parent=base translation=0,15,0
clip oblique interpolation=linear
key oblique tip time=0 rotation=0,0,0,1
key oblique tip time=1 rotation=0.5,0.5,0.5,0.5
skin plate weights=../../target/game-asset-plate.v2.weights.json
face_weights plate ../../target/game-asset-plate-end.faces.json joints=base,tip weights=0.25,0.75 boundary=reject-shared
face_material plate ../../target/game-asset-plate-end.faces.json base_colour=1,0,0,1 roughness=0.2
face_material plate ../../target/game-asset-plate-bottom.faces.json base_colour=0,0,1,1 roughness=0.6

# Equivalent quaternion signs with both moving and stationary intervals.
clip sign_flip interpolation=linear
key sign_flip tip time=0 rotation=0,0,0,1
key sign_flip tip time=0.4 rotation=-0.5,-0.5,-0.5,-0.5
key sign_flip tip time=0.8 rotation=0.5,0.5,0.5,0.5
key sign_flip tip time=1.3 rotation=0,0,0,1
# CAD Z becomes glTF Y: cross the Euler pitch singularity at 90 degrees.
clip crossing interpolation=linear
key crossing tip time=0 rotation=0,0,0.6427876096865394,0.7660444431189780
key crossing tip time=1 rotation=0,0,0.7660444431189780,0.6427876096865394
# Distinct axes and irregular intervals, including a change in arc direction.
clip multi_arc interpolation=linear
key multi_arc tip time=0 rotation=0,0,0,1
key multi_arc tip time=0.37 rotation=0.5,0.5,0.5,0.5
key multi_arc tip time=1.13 rotation=0.7071067811865476,0,0,0.7071067811865476
key multi_arc tip time=2.1 rotation=-0.5,0.5,-0.5,0.5
