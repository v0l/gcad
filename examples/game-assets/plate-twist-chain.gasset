asset 1
project ../..
source plate ../parts/plate.gcad body=main
tessellate plate tolerance=0.1
refine plate levels=2 triangle_budget=20416
uv plate projection=box tile=25
# Five independently posed twist bones share the through-thickness axis.
node plate source=plate
node bone0 translation=0,0,1.5
node bone1 translation=0,0,1.5
node bone2 translation=0,0,1.5
node bone3 translation=0,0,1.5
node bone4 translation=0,0,1.5
node attachment parent=bone4 translation=10,0,0
node payload parent=attachment translation=0,5,0
clip twist interpolation=linear
key twist bone1 time=0 rotation=0,0,0,1
key twist bone1 time=1 rotation=0,0.19509032201612825,0,0.9807852804032304
key twist bone2 time=0 rotation=0,0,0,1
key twist bone2 time=1 rotation=0,0.3826834323650898,0,0.9238795325112867
key twist bone3 time=0 rotation=0,0,0,1
key twist bone3 time=1 rotation=0,0.5555702330196022,0,0.8314696123025452
key twist bone4 time=0 rotation=0,0,0,1
key twist bone4 time=1 rotation=0,0.7071067811865476,0,0.7071067811865476
# --joints bone0,bone1,bone2,bone3,bone4 --chain y,-15,-7.5,0,7.5,15
skin plate weights=../../target/game-asset-plate-twist-chain.weights.json
